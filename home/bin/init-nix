#!/usr/bin/env bash

set -euo pipefail

DOTFILES_RAW="https://raw.githubusercontent.com/gaverhae/dotfiles/refs/heads/main"

SYNC_FLAG=
if [ "${1:-}" = "--latest" ]; then
  SYNC_FLAG=--latest
fi

if [ -e .envrc ] || [ -e .envrc.private ] || [ -e nix ] || [ -e shell.nix ] || [ -e bin/sync-env ]; then
  echo "Conflict. Aborting."
  exit 1
fi

cat <<'EOF' > shell.nix
let
  pkgs = import ./nix/nixpkgs.nix;
  getFlake = url: (builtins.getFlake url).packages.${pkgs.system}.default;
in
pkgs.mkShell {
  LOCALE_ARCHIVE = if pkgs.stdenv.isLinux then "${pkgs.glibcLocales}/lib/locale/locale-archive" else "";
  buildInputs = with pkgs; [
    bash
    cacert
    curl
    jq
  ];
}
EOF

cat <<'EOF' > .envrc
export NIX_CONFIG="experimental-features = nix-command flakes"
use nix
watch_file nix/src.json

PATH_add bin

source_env_if_exists .envrc.private

# If using Python, uncomment to get direnv to activate venv - otherwise, delete
# lock=$(sha256sum requirements.txt 2>&1)
# if ! [ -f .venv/lock ] || [ "$(cat .venv/lock)" != "$lock" ]; then (
#   rm -rf .venv
#   python3 -m venv .venv
#   source .venv/bin/activate
#   echo "$lock" > .venv/lock
#   python -m pip install -r requirements.txt
# ) fi
#
# source .venv/bin/activate
EOF

cat <<EOF > .envrc.private
# Set private env vars here
# export MY_LOCAL_SECRET="super secret stuff"
EOF

echo .envrc.private >> .gitignore

mkdir -p bin
nix-shell -p jq -p curl --run "curl --silent --fail $DOTFILES_RAW/bin/sync-env -o bin/sync-env && chmod +x bin/sync-env && bin/sync-env $SYNC_FLAG"
